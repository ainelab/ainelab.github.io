---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { PI, OPENINGS } from '../data/content.js';
---
<Layout title="People — AI-NE Lab, IIT Indore">
  <Nav />

  <section class="border-b border-line">
    <div class="mx-auto max-w-5xl px-5 py-14 sm:py-16">
      <p class="mono text-xs tracking-[0.2em] uppercase text-brand mb-3">People</p>
      <h1 class="font-serif text-3xl sm:text-4xl font-semibold tracking-tight text-ink">The group</h1>
      <p class="mt-4 text-muted leading-relaxed max-w-2xl">A multidisciplinary group across neuroscience, engineering, mathematics, and AI — and growing.</p>
    </div>
  </section>

  <!-- PI -->
  <section class="border-b border-line">
    <div class="mx-auto max-w-5xl px-5 py-12 sm:py-14">
      <p class="mono text-xs tracking-[0.2em] uppercase text-brand mb-6">Principal Investigator</p>
      <div class="flex flex-col sm:flex-row gap-8">
        <img src="/himanshu-kumar.jpg" alt="Dr. Himanshu Kumar" width="160" height="200" loading="lazy" class="shrink-0 w-40 h-52 object-cover object-top border border-line" />
        <div>
          <h2 class="font-serif text-2xl font-semibold text-ink">{PI.name}</h2>
          <p class="text-sm text-brand-2">{PI.role}</p>
          <p class="text-sm text-brand">{PI.affil}</p>
          <p class="mt-4 text-sm text-muted leading-relaxed max-w-2xl">{PI.bio}</p>
          <ul class="mt-4 space-y-1">
            {PI.awards.map((a) => (<li class="text-[13px] text-muted">— {a}</li>))}
          </ul>
          <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1">
            {PI.links.map(([label, href]) => (
              <a href={href} target="_blank" rel="noopener" class="mono text-[12px] text-brand hover:text-ink transition">{label}</a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- OPENINGS -->
  <section class="border-b border-line bg-panel-2/60">
    <div class="mx-auto max-w-5xl px-5 py-12 sm:py-14">
      <p class="mono text-xs tracking-[0.2em] uppercase text-brand mb-3">Openings</p>
      <h2 class="font-serif text-2xl font-semibold text-ink">A growing group</h2>
      <p class="mt-3 text-sm text-muted max-w-2xl leading-relaxed">Positions are advertised honestly as they open. See how to apply on the <a href="/join" class="text-brand hover:text-ink">Join</a> page.</p>
      <div class="mt-8 divide-y divide-line">
        {OPENINGS.map((o) => (
          <div class="py-5 grid sm:grid-cols-[8rem_1fr] gap-1 sm:gap-8">
            <span class="mono text-[12px] text-brand pt-0.5">{o.level}</span>
            <p class="text-sm text-muted leading-relaxed max-w-2xl">{o.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>
