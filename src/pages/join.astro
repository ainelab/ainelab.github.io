---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Join — AI-NE Lab, IIT Indore">
  <Nav />

  <section class="border-b border-line">
    <div class="mx-auto max-w-5xl px-5 py-9 sm:py-11">
      <p class="mono text-xs tracking-[0.2em] uppercase text-brand mb-3">Join AI-NE Lab</p>
      <h1 class="font-serif text-3xl sm:text-4xl font-semibold tracking-tight text-ink">Curious about the brain?</h1>
    </div>
  </section>

  <section class="border-b border-line">
    <div class="mx-auto max-w-5xl px-5 py-6 sm:py-8">
      <p class="text-muted leading-relaxed max-w-3xl">We invite applications for funded PhD positions in neural signal processing, epilepsy neurotechnology, and AI for neuroscience at AI-NE Lab, BSBE, IIT Indore. Highly motivated undergraduate and master's students with a background in Biomedical, Electrical, Computer Engineering, Physics, or related fields are encouraged to apply. Students will work on research involving EEG/MEG/SEEG signal processing, machine learning, and brain-network modelling, often with clinical and human-participant data.</p>
      <p class="mt-4 text-muted leading-relaxed max-w-3xl"><span class="text-ink font-semibold">Undergraduate openings:</span> research projects are available for students who want experience in signal processing, brain-network analysis, or interpretable machine learning for neural data.</p>
      <div class="mt-8 flex flex-wrap gap-4 items-center">
        <a href="mailto:himanshu@iiti.ac.in?subject=Interest%20in%20joining%20AI-NE%20Lab" class="text-sm font-semibold text-brand hover:text-ink transition">Email the lab →</a>
        <span class="text-line">|</span>
        <a href="https://academic.iiti.ac.in/phdadvt.php" target="_blank" rel="noopener" class="text-sm font-semibold text-brand hover:text-ink transition">Apply through IIT Indore PhD portal →</a>
      </div>
    </div>
  </section>

  <section class="border-b border-line bg-panel-2/60">
    <div class="mx-auto max-w-5xl px-5 py-6 sm:py-8">
      <p class="mono text-xs tracking-[0.2em] uppercase text-brand mb-3">Contact</p>
      <h2 class="font-serif text-2xl font-semibold text-ink">Dr. Himanshu Kumar</h2>
      <ul class="mt-3 space-y-1 text-sm text-muted">
        <li><a href="mailto:himanshu@iiti.ac.in" class="text-brand hover:text-ink">himanshu@iiti.ac.in</a></li>
        <li class="pt-1">Room No. FC 509, LRC Building</li>
        <li>IIT Indore, Khandwa Road, Simrol</li>
        <li>Indore (M.P.) 453552</li>
      </ul>
    </div>
  </section>

  <Footer />
</Layout>
