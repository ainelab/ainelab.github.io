---
import Layout from '../layouts/Layout.astro';
import LogoMark from '../components/LogoMark.astro';
import { RESEARCH, METHODS, PUBLICATIONS, NEWS, PI, OPENINGS, TEACHING } from '../data/content.js';

const nav = [
  ['Research', '#research'],
  ['Team', '#team'],
  ['Publications', '#publications'],
  ['Teaching', '#teaching'],
  ['News', '#news'],
];
---
<Layout>
  <!-- NAV -->
  <header class="fixed top-0 inset-x-0 z-50 border-b border-line bg-paper/95 backdrop-blur-sm">
    <nav class="mx-auto max-w-5xl px-5 h-16 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="#top" class="flex items-center gap-2.5 group">
          <LogoMark size={34} />
          <span class="leading-tight">
            <b class="block text-[15px] tracking-tight text-ink">AI-NE Lab</b>
            <span class="block text-[11px] text-muted">AI &amp; Neural Engineering</span>
          </span>
        </a>
        <span class="hidden sm:block w-px h-8 bg-line"></span>
        <a href="https://bsbe.iiti.ac.in/" target="_blank" rel="noopener" class="flex items-center gap-2.5">
          <img src="/iiti-logo.png" alt="IIT Indore" width="32" height="36" class="h-8 w-auto" />
          <span class="hidden lg:block leading-tight">
            <b class="block text-[15px] tracking-tight text-ink">IIT Indore</b>
            <span class="block text-[11px] text-muted">Indian Institute of Technology Indore</span>
          </span>
        </a>
      </div>
      <div class="hidden md:flex items-center gap-1">
        {nav.map(([label, href]) => (
          <a href={href} class="px-3 py-2 text-sm font-medium text-muted hover:text-ink transition">{label}</a>
        ))}
        <a href="#join" class="px-3 py-2 text-sm font-medium text-muted hover:text-ink transition">Join</a>
      </div>
      <button id="navToggle" aria-label="Menu" class="md:hidden grid place-items-center w-10 h-10 rounded border border-line text-ink">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </nav>
    <div id="mobileMenu" class="md:hidden hidden border-t border-line bg-paper px-5 py-3">
      {nav.map(([label, href]) => (
        <a href={href} class="block py-2.5 text-[15px] text-muted hover:text-ink">{label}</a>
      ))}
      <a href="#join" class="block py-2.5 text-[15px] text-muted hover:text-ink">Join</a>
    </div>
  </header>

  <!-- HERO -->
  <section id="top" class="relative pt-40 pb-20 sm:pt-44 sm:pb-24 border-b border-line">
    <div class="mx-auto max-w-5xl px-5">
      <p class="mono text-xs tracking-[0.2em] uppercase text-brand mb-5">IIT Indore &middot; Mehta Family School of BSBE</p>
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight leading-[1.1] max-w-3xl text-ink">
        AI &amp; Neural Engineering Laboratory
      </h1>
      <p class="mt-5 text-lg sm:text-xl text-ink max-w-2xl leading-snug">
        Advancing brain health through neural signals &amp; AI
      </p>
      <p class="mt-4 text-base sm:text-lg text-muted max-w-2xl leading-relaxed">
        We build computational, data-driven, and neuroengineering approaches to understand the
        human brain in health and neurological disease — across EEG, MEG, and SEEG.
      </p>
      <div class="mt-8 flex flex-wrap gap-4 items-center">
        <a href="#research" class="text-sm font-semibold text-brand hover:text-ink transition">Explore research →</a>
        <span class="text-line">|</span>
        <a href="#publications" class="text-sm font-semibold text-brand hover:text-ink transition">Read our work →</a>
      </div>
    </div>
  </section>

  <!-- RESEARCH -->
  <section id="research" class="relative border-b border-line">
    <div class="mx-auto max-w-5xl px-5 py-16 sm:py-20">
      <div class="reveal max-w-2xl">
        <p class="mono text-xs tracking-[0.2em] uppercase text-brand mb-3">Research areas</p>
        <h2 class="font-serif text-2xl sm:text-3xl font-semibold tracking-tight text-ink">The brain is a dynamic network</h2>
        <p class="mt-4 text-muted leading-relaxed">Five connected themes spanning neural signals, clinical neurotechnology, neurodegeneration, artificial intelligence, and behaviour — turning complex neural data into interpretable markers of brain function.</p>
      </div>

      <div class="mt-10 divide-y divide-line">
        {RESEARCH.map((r) => (
          <article class="reveal py-6 grid sm:grid-cols-[8rem_1fr] gap-2 sm:gap-8">
            <span class="mono text-[11px] uppercase tracking-wide text-brand-2 pt-0.5">{r.tag}</span>
            <div>
              <h3 class="font-serif text-lg font-semibold text-ink">{r.title}</h3>
              <p class="mt-1.5 text-sm text-muted leading-relaxed max-w-xl">{r.body}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="reveal mt-10 pt-8 border-t border-line">
        <p class="mono text-xs tracking-[0.2em] uppercase text-brand mb-4">Methods &amp; approaches</p>
        <p class="text-sm text-muted leading-loose">
          {METHODS.map((m, i) => (<>{m}{i < METHODS.length - 1 ? <span class="text-line px-2">·</span> : null}</>))}
        </p>
      </div>
    </div>
  </section>

  <!-- TEAM -->
  <section id="team" class="relative border-b border-line bg-panel-2/60">
    <div class="mx-auto max-w-5xl px-5 py-16 sm:py-20">
      <div class="reveal max-w-2xl">
        <p class="mono text-xs tracking-[0.2em] uppercase text-brand mb-3">Team</p>
        <h2 class="font-serif text-2xl sm:text-3xl font-semibold tracking-tight text-ink">People</h2>
        <p class="mt-4 text-muted leading-relaxed">A multidisciplinary group across neuroscience, engineering, mathematics, and AI — and growing.</p>
      </div>

      <div class="mt-10 grid gap-10 lg:grid-cols-3">
        <article class="reveal lg:col-span-2 flex flex-col sm:flex-row gap-6 pb-8 border-b border-line lg:border-b-0 lg:pb-0">
          <img src="/himanshu-kumar.jpg" alt="Dr. Himanshu Kumar" width="112" height="140" loading="lazy" class="shrink-0 w-28 h-36 sm:w-32 sm:h-40 object-cover object-top border border-line" />
          <div>
            <span class="mono text-[11px] uppercase tracking-wide text-brand-2">{PI.role}</span>
            <h3 class="font-serif mt-2 text-xl font-semibold text-ink">{PI.name}</h3>
            <p class="text-sm text-brand">{PI.affil}</p>
            <p class="mt-3 text-sm text-muted leading-relaxed">{PI.bio}</p>
            <ul class="mt-4 space-y-1">
              {PI.awards.map((a) => (
                <li class="text-[13px] text-muted">— {a}</li>
              ))}
            </ul>
            <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1">
              {PI.links.map(([label, href]) => (
                <a href={href} target="_blank" rel="noopener" class="mono text-[12px] text-brand hover:text-ink transition">{label}</a>
              ))}
            </div>
          </div>
        </article>

        <div class="reveal">
          <p class="mono text-[11px] uppercase tracking-wide text-brand-2">Students</p>
          <h3 class="font-serif mt-2 text-lg font-semibold text-ink">A growing group</h3>
          <ul class="mt-4 space-y-4">
            {OPENINGS.map((o) => (
              <li>
                <span class="mono text-[11px] text-brand">{o.level}</span>
                <p class="mt-1 text-sm text-muted leading-snug">{o.body}</p>
              </li>
            ))}
          </ul>
          <a href="#join" class="mt-5 inline-block text-sm text-brand hover:text-ink transition">Interested? See how to join →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- PUBLICATIONS -->
  <section id="publications" class="relative border-b border-line">
    <div class="mx-auto max-w-5xl px-5 py-16 sm:py-20">
      <div class="reveal flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-2xl">
          <p class="mono text-xs tracking-[0.2em] uppercase text-brand mb-3">Publications</p>
          <h2 class="font-serif text-2xl sm:text-3xl font-semibold tracking-tight text-ink">Selected recent work</h2>
        </div>
        <a href="https://scholar.google.com/citations?user=rlqKrlwAAAAJ" target="_blank" rel="noopener" class="text-sm font-semibold text-brand hover:text-ink transition">All on Google Scholar →</a>
      </div>

      <ol class="mt-10 divide-y divide-line">
        {PUBLICATIONS.map((p) => (
          <li class="reveal py-5 grid sm:grid-cols-[4.5rem_1fr] gap-1 sm:gap-6 group">
            <div class="mono text-sm text-brand pt-0.5">{p.year}</div>
            <div>
              <p class="mono text-[11px] uppercase tracking-wide text-brand-2">{p.venue}</p>
              {p.link
                ? <a href={p.link} target="_blank" rel="noopener" class="mt-1 block font-semibold leading-snug text-ink group-hover:text-brand transition">{p.title}</a>
                : <p class="mt-1 font-semibold leading-snug text-ink">{p.title}</p>}
              <p class="mt-1 text-sm text-muted">{p.authors}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- TEACHING -->
  <section id="teaching" class="relative border-b border-line bg-panel-2/60">
    <div class="mx-auto max-w-5xl px-5 py-16 sm:py-20">
      <div class="reveal max-w-2xl">
        <p class="mono text-xs tracking-[0.2em] uppercase text-brand mb-3">Teaching</p>
        <h2 class="font-serif text-2xl sm:text-3xl font-semibold tracking-tight text-ink">Courses</h2>
        <p class="mt-4 text-muted leading-relaxed">Coursework at IIT Indore bridging signal processing, machine learning, and neural engineering.</p>
      </div>
      <div class="mt-10 divide-y divide-line">
        {TEACHING.map((c) => (
          <article class="reveal py-6 grid sm:grid-cols-[10rem_1fr] gap-2 sm:gap-8">
            <div>
              <span class="mono text-[11px] text-brand">{c.code}</span>
              <p class="mono text-[11px] text-muted mt-0.5">{c.term}</p>
            </div>
            <div>
              <h3 class="font-serif text-lg font-semibold text-ink">{c.title}</h3>
              {c.credits && <p class="mt-1 mono text-[11px] text-brand-2">L-T-P &middot; {c.credits}</p>}
              <p class="mt-2 text-sm text-muted leading-relaxed">{c.note}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- NEWS -->
  <section id="news" class="relative border-b border-line">
    <div class="mx-auto max-w-5xl px-5 py-16 sm:py-20">
      <div class="reveal max-w-2xl">
        <p class="mono text-xs tracking-[0.2em] uppercase text-brand mb-3">News &amp; updates</p>
        <h2 class="font-serif text-2xl sm:text-3xl font-semibold tracking-tight text-ink">What's happening</h2>
        <p class="mt-4 text-muted leading-relaxed">Recent publications, milestones, and recruitment.</p>
      </div>
      <ol class="mt-10 divide-y divide-line">
        {NEWS.map((n) => (
          <li class="reveal py-4 flex flex-wrap gap-x-4 gap-y-1 sm:items-baseline">
            <time class="mono text-xs text-brand w-20 shrink-0">{n.date}</time>
            <span class="mono text-[10px] uppercase tracking-wide text-brand-2 w-24 shrink-0">{n.tag}</span>
            <p class="text-sm text-ink leading-relaxed max-w-2xl">{n.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- JOIN -->
  <section id="join" class="relative border-b border-line">
    <div class="mx-auto max-w-5xl px-5 py-16 sm:py-20">
      <div class="reveal max-w-3xl">
        <p class="mono text-xs tracking-[0.2em] uppercase text-brand mb-3">Join AI-NE Lab</p>
        <h2 class="font-serif text-2xl sm:text-3xl font-semibold tracking-tight text-ink">Curious about the brain?</h2>
        <p class="mt-4 text-muted leading-relaxed">We invite applications for funded PhD positions in neural signal processing, epilepsy neurotechnology, and AI for neuroscience at AI-NE Lab, BSBE, IIT Indore. Highly motivated undergraduate and master's students with a background in Biomedical, Electrical, Computer Engineering, Physics, or related fields are encouraged to apply. Students will work on research involving EEG/MEG/SEEG signal processing, machine learning, and brain-network modelling, often with clinical and human-participant data.</p>
        <p class="mt-4 text-muted leading-relaxed"><span class="text-ink font-semibold">Undergraduate openings:</span> research projects are available for students who want experience in signal processing, brain-network analysis, or interpretable machine learning for neural data.</p>
        <div class="mt-8 flex flex-wrap gap-4 items-center">
          <a href="mailto:himanshu@iiti.ac.in?subject=Interest%20in%20joining%20AI-NE%20Lab" class="text-sm font-semibold text-brand hover:text-ink transition">Email the lab →</a>
          <span class="text-line">|</span>
          <a href="https://academic.iiti.ac.in/phdadvt.php" target="_blank" rel="noopener" class="text-sm font-semibold text-brand hover:text-ink transition">Apply through IIT Indore PhD portal →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer>
    <div class="mx-auto max-w-5xl px-5 py-12 grid gap-8 sm:grid-cols-3">
      <div>
        <div class="flex items-center gap-2.5">
          <LogoMark size={32} />
          <b class="text-ink">AI-NE Lab</b>
        </div>
        <p class="mt-3 text-sm text-muted max-w-xs">Advancing brain health through neural signals and artificial intelligence.</p>
        <a href="https://bsbe.iiti.ac.in/" target="_blank" rel="noopener" class="mt-5 flex items-center gap-3">
          <img src="/iiti-logo.png" alt="Indian Institute of Technology Indore" width="40" height="44" loading="lazy" class="h-10 w-auto" />
          <span class="text-xs text-muted leading-tight">Indian Institute of<br />Technology Indore</span>
        </a>
      </div>
      <div class="text-sm">
        <h4 class="font-semibold text-ink mb-3">Explore</h4>
        <ul class="space-y-2 text-muted">
          {nav.map(([label, href]) => (<li><a href={href} class="hover:text-brand">{label}</a></li>))}
          <li><a href="#join" class="hover:text-brand">Join</a></li>
        </ul>
      </div>
      <div class="text-sm">
        <h4 class="font-semibold text-ink mb-3">Contact</h4>
        <ul class="space-y-2 text-muted">
          <li class="text-ink font-semibold">Dr. Himanshu Kumar</li>
          <li><a href="mailto:himanshu@iiti.ac.in" class="hover:text-brand">himanshu@iiti.ac.in</a></li>
          <li class="pt-1">Room No. FC 509, LRC Building</li>
          <li>IIT Indore, Khandwa Road, Simrol</li>
          <li>Indore (M.P.) 453552</li>
        </ul>
      </div>
    </div>
    <div class="border-t border-line">
      <div class="mx-auto max-w-5xl px-5 py-5 flex flex-wrap justify-between gap-2 text-xs text-muted">
        <span>© <span id="year">2026</span> AI-NE Lab, IIT Indore.</span>
      </div>
    </div>
  </footer>

  <script>
    // mobile menu
    const t = document.getElementById('navToggle');
    const m = document.getElementById('mobileMenu');
    t?.addEventListener('click', () => m?.classList.toggle('hidden'));
    m?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => m.classList.add('hidden')));

    // scroll reveal
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

    const y = document.getElementById('year');
    if (y) y.textContent = String(new Date().getFullYear());
  </script>
</Layout>
