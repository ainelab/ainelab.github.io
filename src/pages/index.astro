---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { RESEARCH, NEWS, PI } from '../data/content.js';
---
<Layout>
  <Nav />

  <!-- HERO -->
  <section class="border-b border-line">
    <img src="/brain-hero.jpg" alt="" aria-hidden="true" class="w-full h-[26vh] sm:h-[32vh] object-cover object-center" />
    <div class="mx-auto max-w-5xl px-5 py-9 sm:py-11">
      <p class="mono text-xs tracking-[0.2em] uppercase text-brand mb-5">IIT Indore &middot; Mehta Family School of BSBE</p>
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight leading-[1.1] max-w-3xl text-ink">
        AI &amp; Neural Engineering Laboratory
      </h1>
      <p class="mt-5 text-lg sm:text-xl text-ink max-w-2xl leading-snug">
        Advancing brain health through neural signals &amp; AI
      </p>
      <p class="mt-4 text-base sm:text-lg text-muted max-w-2xl leading-relaxed">
        We build computational, data-driven, and neuroengineering approaches to understand the
        human brain in health and neurological disease — across EEG, MEG, and SEEG.
      </p>
      <div class="mt-8 flex flex-wrap gap-4 items-center">
        <a href="/research" class="text-sm font-semibold text-brand hover:text-ink transition">Explore research →</a>
        <span class="text-line">|</span>
        <a href="/publications" class="text-sm font-semibold text-brand hover:text-ink transition">Read our work →</a>
      </div>
    </div>
  </section>

  <!-- RESEARCH OVERVIEW -->
  <section class="border-b border-line">
    <div class="mx-auto max-w-5xl px-5 py-9 sm:py-11">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-2xl">
          <p class="mono text-xs tracking-[0.2em] uppercase text-brand mb-3">Research</p>
          <h2 class="font-serif text-2xl sm:text-3xl font-semibold tracking-tight text-ink">The brain is a dynamic network</h2>
        </div>
        <a href="/research" class="text-sm font-semibold text-brand hover:text-ink transition">All research areas →</a>
      </div>
      <div class="mt-8 divide-y divide-line">
        {RESEARCH.map((r) => (
          <article class="py-4 grid sm:grid-cols-[8rem_1fr] gap-2 sm:gap-8">
            <span class="mono text-[11px] uppercase tracking-wide text-brand-2 pt-0.5">{r.tag}</span>
            <div>
              <h3 class="font-serif text-lg font-semibold text-ink">{r.title}</h3>
              <p class="mt-1.5 text-sm text-muted leading-relaxed max-w-xl">{r.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- PI SNAPSHOT -->
  <section class="border-b border-line bg-panel-2/60">
    <div class="mx-auto max-w-5xl px-5 py-9 sm:py-11 flex flex-col sm:flex-row gap-6 items-start">
      <img src="/himanshu-kumar.jpg" alt="Dr. Himanshu Kumar" width="112" height="140" loading="lazy" class="shrink-0 w-28 h-36 object-cover object-top border border-line" />
      <div>
        <p class="mono text-xs tracking-[0.2em] uppercase text-brand mb-2">Principal Investigator</p>
        <h2 class="font-serif text-2xl font-semibold text-ink">{PI.name}</h2>
        <p class="text-sm text-brand">{PI.affil}</p>
        <p class="mt-3 text-sm text-muted leading-relaxed max-w-2xl">{PI.bio}</p>
        <a href="/people" class="mt-4 inline-block text-sm font-semibold text-brand hover:text-ink transition">Meet the group →</a>
      </div>
    </div>
  </section>

  <!-- LATEST NEWS -->
  <section class="border-b border-line">
    <div class="mx-auto max-w-5xl px-5 py-9 sm:py-11">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="mono text-xs tracking-[0.2em] uppercase text-brand mb-3">News</p>
          <h2 class="font-serif text-2xl sm:text-3xl font-semibold tracking-tight text-ink">Latest updates</h2>
        </div>
        <a href="/news" class="text-sm font-semibold text-brand hover:text-ink transition">All news →</a>
      </div>
      <ol class="mt-8 divide-y divide-line">
        {NEWS.slice(0, 3).map((n) => (
          <li class="py-4 flex flex-wrap gap-x-4 gap-y-1 sm:items-baseline">
            <time class="mono text-xs text-brand w-20 shrink-0">{n.date}</time>
            <span class="mono text-[10px] uppercase tracking-wide text-brand-2 w-24 shrink-0">{n.tag}</span>
            <p class="text-sm text-ink leading-relaxed max-w-2xl">{n.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Footer />
</Layout>
