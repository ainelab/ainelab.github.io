---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { NEWS } from '../data/content.js';
---
<Layout title="News · AI-NE Lab, IIT Indore">
  <Nav />

  <section class="border-b border-line">
    <div class="mx-auto max-w-5xl px-5 py-9 sm:py-11">
      <p class="mono text-xs tracking-[0.2em] uppercase text-brand mb-3">News &amp; updates</p>
      <h1 class="font-serif text-3xl sm:text-4xl font-semibold tracking-tight text-ink">What's happening</h1>
      <p class="mt-4 text-muted leading-relaxed max-w-2xl">Recent publications, milestones, and recruitment.</p>
    </div>
  </section>

  <section class="border-b border-line">
    <div class="mx-auto max-w-5xl px-5 py-6 sm:py-8">
      <ol class="divide-y divide-line">
        {NEWS.map((n) => (
          <li class="py-4 flex flex-wrap gap-x-4 gap-y-1 sm:items-baseline">
            <time class="mono text-xs text-brand w-20 shrink-0">{n.date}</time>
            <span class="mono text-[10px] uppercase tracking-wide text-brand-2 w-24 shrink-0">{n.tag}</span>
            <p class="text-sm text-ink leading-relaxed max-w-2xl">{n.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Footer />
</Layout>
