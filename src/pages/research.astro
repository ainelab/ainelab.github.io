---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { RESEARCH, METHODS } from '../data/content.js';
---
<Layout title="Research — AI-NE Lab, IIT Indore">
  <Nav />

  <section class="border-b border-line">
    <div class="mx-auto max-w-5xl px-5 py-14 sm:py-16">
      <p class="mono text-xs tracking-[0.2em] uppercase text-brand mb-3">Research</p>
      <h1 class="font-serif text-3xl sm:text-4xl font-semibold tracking-tight text-ink">The brain is a dynamic network</h1>
      <p class="mt-4 text-muted leading-relaxed max-w-2xl">Five connected themes spanning neural signals, clinical neurotechnology, neurodegeneration, artificial intelligence, and behaviour — turning complex neural data into interpretable markers of brain function.</p>
    </div>
  </section>

  <section class="border-b border-line">
    <div class="mx-auto max-w-5xl px-5 py-12 sm:py-14 divide-y divide-line">
      {RESEARCH.map((r) => (
        <article class="py-7 grid sm:grid-cols-[9rem_1fr] gap-2 sm:gap-8">
          <span class="mono text-[11px] uppercase tracking-wide text-brand-2 pt-1">{r.tag}</span>
          <div>
            <h2 class="font-serif text-xl font-semibold text-ink">{r.title}</h2>
            <p class="mt-2 text-sm text-muted leading-relaxed max-w-2xl">{r.body}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="border-b border-line">
    <div class="mx-auto max-w-5xl px-5 py-12 sm:py-14">
      <p class="mono text-xs tracking-[0.2em] uppercase text-brand mb-4">Methods &amp; approaches</p>
      <p class="text-sm text-muted leading-loose max-w-3xl">
        {METHODS.map((m, i) => (<>{m}{i < METHODS.length - 1 ? <span class="text-line px-2">·</span> : null}</>))}
      </p>
    </div>
  </section>

  <Footer />
</Layout>
