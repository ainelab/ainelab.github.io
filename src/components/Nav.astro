---
import LogoMark from './LogoMark.astro';

const nav = [
  ['Home', '/'],
  ['Research', '/research'],
  ['People', '/people'],
  ['Publications', '/publications'],
  ['Teaching', '/teaching'],
  ['News', '/news'],
  ['Join', '/join'],
];

// Normalise current path (strip trailing slash) for active-link matching.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---
<header class="sticky top-0 z-50 border-b border-line bg-paper/90 backdrop-blur-md">
  <div class="mx-auto max-w-5xl px-5 h-16 flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2.5 shrink-0">
      <LogoMark size={34} />
      <span class="leading-tight">
        <b class="block text-[15px] tracking-tight text-ink">AI-NE Lab</b>
        <span class="block text-[11px] text-muted">AI &amp; Neural Engineering &middot; IIT Indore</span>
      </span>
    </a>

    <!-- desktop links -->
    <nav class="hidden md:flex items-center gap-x-5 text-sm">
      {nav.map(([label, href]) => (
        <a href={href} class={`py-1 font-medium transition ${isActive(href) ? 'text-brand border-b-2 border-brand' : 'text-muted hover:text-ink'}`}>{label}</a>
      ))}
    </nav>

    <!-- mobile toggle -->
    <button id="navToggle" aria-label="Menu" aria-expanded="false" class="md:hidden grid place-items-center w-10 h-10 rounded border border-line text-ink shrink-0">
      <svg id="navIconOpen" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      <svg id="navIconClose" class="hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>

  <!-- mobile dropdown -->
  <nav id="mobileMenu" class="hidden md:hidden border-t border-line bg-paper px-5 py-2">
    {nav.map(([label, href]) => (
      <a href={href} class={`block py-2.5 text-[15px] font-medium ${isActive(href) ? 'text-brand' : 'text-muted'}`}>{label}</a>
    ))}
  </nav>
</header>
<script>
  const t = document.getElementById('navToggle');
  const m = document.getElementById('mobileMenu');
  const io = document.getElementById('navIconOpen');
  const ic = document.getElementById('navIconClose');
  const setOpen = (open) => {
    m?.classList.toggle('hidden', !open);
    io?.classList.toggle('hidden', open);
    ic?.classList.toggle('hidden', !open);
    t?.setAttribute('aria-expanded', String(open));
  };
  t?.addEventListener('click', () => setOpen(m?.classList.contains('hidden') ?? true));
  m?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>
