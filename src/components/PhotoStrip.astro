---
// Horizontal, swipeable photo strip with captions. No autoplay: CSS scroll-snap plus arrow buttons.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Item { file: string; caption: string; alt: string }
const { items, label = 'Photos' } = Astro.props as { items: Item[]; label?: string };

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/moments/*.{jpg,jpeg,png,webp}', { eager: true });
const resolve = (name: string) => {
  const hit = Object.entries(files).find(([path]) => path.endsWith('/' + name));
  if (!hit) throw new Error(`PhotoStrip: missing src/assets/moments/${name}`);
  return hit[1].default;
};
---
<div class="photo-strip relative" data-photo-strip>
  <div class="flex justify-end gap-2 mb-3">
    <button type="button" data-dir="-1" aria-label="Previous photos"
            class="w-9 h-9 grid place-items-center border border-line text-ink hover:border-brand hover:text-brand transition disabled:opacity-30 disabled:pointer-events-none">←</button>
    <button type="button" data-dir="1" aria-label="Next photos"
            class="w-9 h-9 grid place-items-center border border-line text-ink hover:border-brand hover:text-brand transition disabled:opacity-30 disabled:pointer-events-none">→</button>
  </div>
  <ul class="strip-track flex gap-4 overflow-x-auto snap-x snap-mandatory pb-3" tabindex="0" role="region" aria-label={label}>
    {items.map((m) => (
      <li class="snap-start shrink-0">
        <figure class="w-min">
          <Image src={resolve(m.file)} alt={m.alt} height={288} densities={[1, 2]} format="webp" quality={80} loading="lazy"
                 class="h-60 sm:h-72 w-auto max-w-[85vw] object-cover border border-line" />
          <figcaption class="mt-2 mono text-[11px] leading-snug text-muted">{m.caption}</figcaption>
        </figure>
      </li>
    ))}
  </ul>
</div>

<style>
  .strip-track { scrollbar-width: thin; scroll-padding-inline: 0; }
  .strip-track:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 4px; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-photo-strip]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.strip-track')!;
    const [prev, next] = root.querySelectorAll<HTMLButtonElement>('button[data-dir]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const update = () => {
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
    };
    root.querySelectorAll<HTMLButtonElement>('button[data-dir]').forEach((b) =>
      b.addEventListener('click', () =>
        track.scrollBy({ left: Number(b.dataset.dir) * track.clientWidth * 0.8, behavior: reduced ? 'auto' : 'smooth' })));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>
